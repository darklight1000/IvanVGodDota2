@model IEnumerable<HorseClub.Models.Service>

@{
    ViewData["Title"] = "Акции";
}

<section class="page-header">
    <div class="container">
        <h1>Акции и специальные предложения</h1>
        <p>Выгодные предложения для вас и ваших лошадей</p>
    </div>
</section>

<section class="section">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="cards-grid">
                @foreach (var item in Model)
                {
                    <div class="card">
                        <div class="card-img">
                            <span class="promo-badge">Акция</span>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" />
                            }
                            else
                            {
                                <div class="placeholder-icon">🐎</div>
                            }
                        </div>
                        <div class="card-body">
                            <h3>@item.Name</h3>
                            <p>@item.Description</p>
                            <div class="card-price">@item.Price.ToString("N0") ₽</div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="text-align: center; font-size: 1.2rem; color: #6b5b4a;">Пока нет активных акций. Следите за обновлениями!</p>
        }
    </div>
</section>