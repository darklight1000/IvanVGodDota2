@model HorseClub.Models.Cart
@{
    ViewData["Title"] = "Корзина";
    decimal total = Model?.Items?.Sum(i => (i.Service?.Price ?? 0) * i.Quantity) ?? 0;
}

<section class="section">
    <div class="container">
        <h1>Ваша корзина</h1>

        @if (Model == null || !Model.Items.Any())
        {
            <div style="background:#fff; padding:40px; border-radius:14px; text-align:center; color:#8a7762; box-shadow: var(--shadow); margin-top:20px;">
                <h2 style="font-size:1.5rem; margin-bottom:10px;">Корзина пуста</h2>
                <p>Самое время выбрать что-то интересное в нашем каталоге!</p>
                <a href="/Catalog" class="btn btn-primary" style="margin-top:16px;">Перейти в каталог</a>
            </div>
        }
        else
        {
            <div style="display:grid; grid-template-columns: 1fr 340px; gap:32px; align-items:start; margin-top:24px;">

                <!-- СПИСОК ТОВАРОВ -->
                <div style="display:flex; flex-direction:column; gap:16px;">
                    @foreach (var item in Model.Items)
                    {
                        <div style="background:#fff; padding:20px; border-radius:14px; box-shadow:var(--shadow); display:flex; gap:20px; align-items:center;">
                            <!-- Фото -->
                            <div style="width:100px; height:100px; flex-shrink:0; border-radius:8px; overflow:hidden; background:var(--color-light); display:flex; align-items:center; justify-content:center;">
                                @if (!string.IsNullOrEmpty(item.Service?.ImageUrl))
                                {
                                    <img src="@item.Service.ImageUrl" style="width:100%; height:100%; object-fit:cover;" />
                                }
                                else
                                {

                                    <span style="font-size:2rem;">🐎</span>
                                }
                            </div>

                            <!-- Инфо -->
                            <div style="flex-grow:1;">
                                <h3 style="margin:0 0 4px; font-size:1.1rem;">@item.Service?.Name</h3>
                                <p style="margin:0; color:#8a7762; font-size:0.9rem;">@item.Service?.Category</p>

                                @if (item.BookingDate.HasValue)
                                {
                                    <div style="margin-top:6px; font-size:0.9rem; color:#e65100; font-weight:600;">
                                        📅 @item.BookingDate.Value.ToString("dd.MM.yyyy HH:mm")
                                    </div>
                                }

                                <div style="font-weight:700; color:var(--color-accent); margin-top:8px;">
                                    @item.Service?.Price.ToString("N0") ₽
                                </div>
                            </div>

                            <!-- Количество и удаление -->
                            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:12px;">
                                <form method="post" asp-action="Remove" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <button type="submit" style="background:none; border:none; color:#c62828; cursor:pointer; font-size:0.9rem;">
                                        ✖ Удалить
                                    </button>
                                </form>
                                <div style="display:flex; align-items:center; gap:8px; background:var(--color-light); padding:4px 8px; border-radius:6px;">
                                    <span style="font-size:0.9rem; color:#8a7762;">Кол-во:</span>
                                    <span style="font-weight:bold;">@item.Quantity</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- БЛОК ИТОГА -->
                <aside style="background:#fff; padding:24px; border-radius:14px; box-shadow:var(--shadow); position:sticky; top:90px;">
                    <h3 style="margin-top:0; border-bottom:2px solid var(--color-light); padding-bottom:12px;">Итого</h3>

                    <div style="display:flex; justify-content:space-between; margin-bottom:12px; color:#6b5b4a;">
                        <span>Товары (@Model.Items.Sum(i => i.Quantity) шт.):</span>
                        <span>@total.ToString("N0") ₽</span>
                    </div>

                    <div style="display:flex; justify-content:space-between; font-size:1.4rem; font-weight:700; color:var(--color-primary); margin-bottom:20px;">
                        <span>Сумма:</span>
                        <span>@total.ToString("N0") ₽</span>
                    </div>

                    <form method="post" asp-action="Checkout" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary" style="width:100%; padding:14px; font-size:1.05rem;">
                            Оформить заказ
                        </button>
                    </form>
                </aside>
            </div>
        }
    </div>
</section>