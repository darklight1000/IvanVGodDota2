@model IEnumerable<HorseClub.Models.Service>

@{
    ViewData["Title"] = "Управление новинками";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>✨ Управление новинками</h2>
        <!-- Кнопка ведет на ту же форму создания, что и для каталога -->
        <a asp-action="CreateService" class="btn btn-success">+ Добавить новинку</a>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Назад в админку</a>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Название</th>
                    <th>Цена</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Price.ToString("N0") ₽</td>
                        <td>
                            <span class="badge bg-success">Новинка</span>
                            @if (item.IsPromo)
                            {
                                <span class="badge bg-danger">Акция</span>
                            }
                        </td>  
                        <td>
                            <div class="d-flex gap-2">
                                <!-- Кнопки ведут на те же методы редактирования и удаления -->
                                <a asp-action="EditService" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Ред.</a>
                                <form asp-action="DeleteService" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Удалить новинку?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Удал.</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            Пока нет услуг, отмеченных как «Новинка».
            <a asp-action="CreateService" class="alert-link">Создайте новую</a> или отметьте галочку в существующей услуге.
        </div>
    }
</div>