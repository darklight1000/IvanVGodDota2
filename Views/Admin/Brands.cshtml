@model IEnumerable<HorseClub.Models.Brand>

<div class="container mt-5">
    <h2>🏷️ Управление брендами</h2>
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Назад в админку</a>

    <table class="table table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Логотип</th>
                <th>Название</th>
                <th>Описание</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var brand in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(brand.LogoUrl))
                        {
                            <img src="@brand.LogoUrl" alt="@brand.Name" style="max-height: 40px;" />
                        }
                        else
                        {
                            <span class="text-muted">Нет лого</span>
                        }
                    </td>
                    <td>@brand.Name</td>
                    <td>@brand.Description</td>
                    <td>
                        <form asp-action="DeleteBrand" asp-route-id="@brand.Id" method="post" onsubmit="return confirm('Удалить бренд?');">
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center">Брендов пока нет.</td></tr>
            }
        </tbody>
    </table>
</div>