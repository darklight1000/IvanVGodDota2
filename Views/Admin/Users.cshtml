@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container mt-5">
    <h2>👥 Пользователи системы</h2>
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Назад в админку</a>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Email</th>
                <th>Имя пользователя</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.UserName</td>
                    <td>
                        @if (user.EmailConfirmed)
                        {
                            <span class="badge bg-success">Подтвержден</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Ожидает</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditUserRoles" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Изменить роли</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>