@model HorseClub.Models.Service

<div class="container mt-5">
    <h2>➕ Добавление услуги</h2>
    <a asp-action="Services" class="btn btn-outline-secondary mb-3">← Назад</a>

    <div class="card shadow-sm p-4 col-md-8">
        <form asp-action="CreateService" method="post">
            <div class="mb-3">
                <label class="form-label">Название</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Категория</label>
                <input asp-for="Category" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Цена (₽)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
            </div>
            <div class="mb-3">
                <label class="form-label">Ссылка на картинку (URL)</label>
                <input asp-for="ImageUrl" class="form-control" />
            </div>
            <div class="form-check mb-2">
                <input asp-for="IsPromo" class="form-check-input" />
                <label asp-for="IsPromo" class="form-check-label">Это акция</label>
            </div>
            <div class="form-check mb-4">
                <input asp-for="IsNew" class="form-check-input" />
                <label asp-for="IsNew" class="form-check-label">Это новинка</label>
            </div>
            <button type="submit" class="btn btn-primary">Сохранить</button>
        </form>
    </div>
</div>