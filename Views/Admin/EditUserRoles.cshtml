@{
    ViewData["Title"] = "Изменение ролей";
    var user = ViewBag.User as Microsoft.AspNetCore.Identity.IdentityUser;
    var userRoles = ViewBag.UserRoles as IList<string>;
    var allRoles = ViewBag.AllRoles as List<Microsoft.AspNetCore.Identity.IdentityRole>;
}

<div class="container mt-5">
    <h2>Изменение ролей для @user?.Email</h2>
    <a asp-action="Users" class="btn btn-outline-secondary mb-3">← Назад к списку</a>

    <div class="card shadow-sm p-4 col-md-6">
        <form method="post">
            <input type="hidden" name="userId" value="@user?.Id" />
            
            <h5>Выберите роль:</h5>
            @foreach (var role in allRoles)
            {
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="selectedRoles" value="@role.Name"
                           id="role_@role.Id" @(userRoles.Contains(role.Name) ? "checked" : "") />
                    <label class="form-check-label" for="role_@role.Id">
                        @role.Name
                    </label>
                </div>
            }
            
            <button type="submit" class="btn btn-success mt-3">Сохранить изменения</button>
        </form>
    </div>
</div>