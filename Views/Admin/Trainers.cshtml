@model IEnumerable<HorseClub.Models.Trainer>

@{
    ViewData["Title"] = "Управление тренерами";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>👨‍🏫 Управление тренерами</h2>
        <a asp-action="CreateTrainer" class="btn btn-success">➕ Добавить тренера</a>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Назад в админку</a>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;">Фото</th>
                        <th>Имя</th>
                        <th>Специализация</th>
                        <th>Описание</th>
                        <th style="width: 200px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trainer in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(trainer.ImageUrl))
                                {
                                    <img src="@trainer.ImageUrl" alt="@trainer.Name" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" />
                                }
                                else
                                {
                                    <div style="width: 50px; height: 50px; border-radius: 50%; background: #eee; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">👤</div>
                                }
                            </td>
                            <td class="align-middle fw-bold">@trainer.Name</td>
                            <td class="align-middle">@trainer.Specialization</td>
                            <td class="align-middle text-muted" style="max-width: 300px;">@trainer.Description</td>
                            <td class="align-middle">
                                <div class="d-flex gap-2">
                                    <a asp-action="EditTrainer" asp-route-id="@trainer.Id" class="btn btn-sm btn-primary">✏️ Изменить</a>
                                    <form asp-action="DeleteTrainer" asp-route-id="@trainer.Id" method="post" style="display:inline;" onsubmit="return confirm('Вы уверены, что хотите удалить этого тренера?');">
                                        <button type="submit" class="btn btn-sm btn-danger">🗑️ Удалить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Тренеров пока нет. Добавьте первого!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>