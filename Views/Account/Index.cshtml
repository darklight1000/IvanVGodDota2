@model List<HorseClub.Models.Booking>
@{
    ViewData["Title"] = "Личный кабинет";
}

<section class="section">
    <div class="container">
        <h1>Личный кабинет</h1>
        <p style="color:#8a7762;">Вы вошли как: <strong>@User.Identity?.Name</strong></p>

        <div style="display:flex; gap:16px; margin:24px 0; flex-wrap:wrap;">
            <a href="/Catalog" class="btn btn-primary">🐎 Записаться на занятие</a>
            <form method="post" asp-action="Logout" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn" style="background:#ffebee; color:#c62828;">Выйти</button>
            </form>
        </div>

        <h2>Мои бронирования</h2>

        @if (!Model.Any())
        {
            <div style="background:#fff; padding:40px; border-radius:14px; text-align:center; color:#8a7762; box-shadow: var(--shadow);">
                У вас пока нет бронирований. <a href="/Catalog">Выберите услугу</a> и запишитесь на занятие.
            </div>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:16px;">
                @foreach (var booking in Model)
                {
                    <div style="background:#fff; padding:20px; border-radius:14px; box-shadow:var(--shadow); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
                        <div>
                            <h3 style="margin:0 0 6px;">@booking.Service?.Name</h3>

                            <!-- ВЫВОД ТРЕНЕРА -->
                            @if (booking.Trainer != null)
                            {
                                <div style="font-size:0.9rem; color:#4a3a28; margin-bottom:6px;">
                                    👨‍🏫 Тренер: <strong>@booking.Trainer.Name</strong>
                                    <span style="color:#8a7762;">(@booking.Trainer.Specialization)</span>
                                </div>
                            }
                            else
                            {
                                <div style="font-size:0.9rem; color:#8a7762; margin-bottom:6px;">
                                    👨‍🏫 Тренер: Любой
                                </div>
                            }

                            <p style="margin:0; color:#6b5b4a; font-size:0.9rem;">
                                📅 @booking.BookingDate.ToString("dd.MM.yyyy HH:mm") ·
                                💰 @(booking.Service?.Price.ToString("N0") ?? "0") ₽
                            </p>
                            <span style="display:inline-block; margin-top:8px; padding:4px 12px; border-radius:6px; font-size:0.85rem; font-weight:600;
                                @(booking.Status == "Ожидает" ? "background:#fff3e0; color:#e65100;" : "")
                                @(booking.Status == "Подтверждено" ? "background:#e8f5e9; color:#2e7d32;" : "")
                                @(booking.Status == "Отменено" ? "background:#ffebee; color:#c62828;" : "")">
                                @booking.Status
                            </span>
                        </div>
                        @if (booking.Status == "Ожидает")
                        {
                            <form method="post" asp-action="CancelBooking" asp-route-id="@booking.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn" style="background:#ffebee; color:#c62828; padding:8px 16px; font-size:0.9rem;"
                                        onclick="return confirm('Отменить бронирование?');">
                                    Отменить
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>